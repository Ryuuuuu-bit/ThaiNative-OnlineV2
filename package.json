{
  "name": "the-beginning-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "preview": "vite preview",
    "test": "npm run build:shared && npm run test:meadow && npm run test:server && npm run test:web && npm run test:shared",
    "dev:meadow": "npm run build:shared && vite meadow-3d --host 127.0.0.1 --port 5173",
    "build:meadow": "vite build meadow-3d",
    "test:meadow": "node --test meadow-3d/tests/*.test.mjs",
    "check:meadow": "npm run build:shared && tsc -p meadow-3d/tsconfig.json",
    "build:server": "npm --prefix server ci --include=dev && npm --prefix server run build",
    "build:web": "node scripts/build-web.mjs",
    "start": "node server/build/index.js",
    "dev:server": "npm run build:shared && npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "test:web": "node --test meadow-3d/web-tests/*.test.mjs",
    "build:shared": "npm --workspace @the-beginning-online/shared run build",
    "test:shared": "npm --workspace @the-beginning-online/shared test",
    "sim:balance": "npm --workspace @the-beginning-online/shared run sim:balance --",
    "tools:ktx2": "node meadow-3d/tools/install-ktx2.mjs",
    "pack:textures": "node meadow-3d/tools/pack-ktx2.mjs",
    "pack:audio": "node meadow-3d/tools/pack-audio.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "easystarjs": "0.4.4",
    "pixi.js": "8.22.0",
    "rbush": "4.0.1",
    "three": "0.185.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/rbush": "4.0.0",
    "@types/three": "^0.185.4",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "workspaces": [
    "shared"
  ]
}
