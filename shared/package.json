{
  "name": "@thainative/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "default": {
        "types": "./dist/src/index.node.d.ts",
        "default": "./dist/src/index.node.js"
      }
    },
    "./collision": {
      "types": "./dist/src/game/collision.d.ts",
      "default": "./dist/src/game/collision.js"
    },
    "./movement": {
      "types": "./dist/src/game/movement.d.ts",
      "default": "./dist/src/game/movement.js"
    },
    "./prediction": {
      "types": "./dist/src/game/prediction.d.ts",
      "default": "./dist/src/game/prediction.js"
    },
    "./constants": {
      "types": "./dist/src/game/constants.d.ts",
      "default": "./dist/src/game/constants.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "sim:balance": "npm run build && node dist/sim/balance.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
